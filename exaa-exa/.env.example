# ── AI answer formatter (Groq) ─────────────────────────────
# Copy this file to .env.local and paste your key (https://console.groq.com/keys).
# Server-side only: read by /api/ai-format (Vercel) and the Vite dev server.
# Do NOT prefix with VITE_ — that would ship the key to every browser.
GROQ_API_KEY=

# Optional: any Groq chat model
GROQ_MODEL=openai/gpt-oss-120b

# ── ImageKit.io credentials ──────────────────────────────────
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
